{
  "name": "zhuma",
  "version": "0.0.0",
  "private": true,
  "description": "Plugin-first agent workbench built on DeepSeek Harness Desktop.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "pnpm build && pnpm -r --if-present run typecheck",
    "test": "pnpm build && node scripts/run-tests.mjs",
    "test:browser": "pnpm build && node --test examples/agent-workspace/browser.test.mjs",
    "workspace:demo": "pnpm build && node examples/agent-workspace/server.mjs",
    "check": "pnpm check:repo && pnpm brand:check && pnpm format:check && pnpm typecheck && pnpm test",
    "check:repo": "node scripts/check-repo.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.mjs",
    "doctor": "node scripts/doctor.mjs",
    "upstream:init": "git submodule update --init --recursive",
    "upstream:check": "node scripts/check-upstream.mjs",
    "upstream:build-dsh": "node scripts/build-upstream-dsh.mjs",
    "desktop:prepare": "node scripts/desktop/prepare.mjs",
    "desktop:dev": "node scripts/desktop/run.mjs dev",
    "desktop:package:mac": "node scripts/desktop/run.mjs package",
    "desktop:reset": "node scripts/desktop/reset.mjs",
    "desktop:verify:mac": "node scripts/desktop/verify.mjs",
    "brand:check": "node scripts/desktop/check-icons.mjs",
    "desktop:verify:icons": "node scripts/desktop/check-running-icons.mjs",
    "workbench:build": "node scripts/workbench/build.mjs",
    "workbench:stage": "pnpm workbench:build && node scripts/workbench/install-stage.mjs",
    "test:ui": "pnpm workbench:build && pnpm test:ui:run",
    "test:host": "pnpm workbench:build && pnpm test:host:run",
    "test:host:run": "node scripts/workbench/verify-host.mjs",
    "test:ui:run": "playwright test --config packages/client/tests/browser/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "esbuild": "0.25.12",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
