+// Resource-lifecycle contracts. These handles are deliberately synthetic; the
+// runtime disposal suite separately checks original connection/cleanup facts.
+describe('live ACP resource projection', () => {
+  function runtime(close: () => Promise<void>, physical: () => boolean | undefined = () => true) {
+    return {
+      close,
+      get physicalCleanupConfirmed() {
+        return physical()
+      },
+      hasPendingHostCalls: () => false,
+      hasUncommittedHostFeedback: () => false,
+      hasRetainedHostFeedback: () => false,
+    }
+  }
+  it('reads empty only from a real empty resource registry, independent of history/profile text', () => {
+    expect(listLiveRuntimeSessions(new Context())).toEqual([])
+  })
+  it('keeps the exact runtime visible across child/plugin replacement until close and physical drain', async () => {
+    const root = new Context(),
+      child = root.extend({})
+    const completion = Promise.withResolvers<void>()
+    const owner = runtime(() => completion.promise)
+    retainLiveRuntime(root, 'actual-session', owner)
+    expect(listLiveRuntimeSessions(child).map((row) => row.sessionId)).toEqual(['actual-session'])
+    expect(listLiveRuntimeSessions(new Context())).toEqual([])
+    const closing = closeLiveRuntime(root, 'actual-session', owner)
+    expect(listLiveRuntimeSessions(child)).toHaveLength(1)
+    completion.resolve()
+    await closing
+    expect(listLiveRuntimeSessions(child)).toEqual([])
+  })
+  it('does not equate fulfilled close with physical cleanup', async () => {
+    const root = new Context()
+    let physical = false
+    const owner = runtime(
+      async () => {},
+      () => physical,
+    )
+    retainLiveRuntime(root, 'unconfirmed-session', owner)
+    await closeLiveRuntime(root, 'unconfirmed-session', owner)
+    expect(listLiveRuntimeSessions(root)).toHaveLength(1)
+    physical = true
+    expect(listLiveRuntimeSessions(root)).toEqual([])
+  })
+  it('retains failed cleanup even when another visible fact says quiescent', async () => {
+    const root = new Context()
+    const owner = runtime(async () => {
+      throw new Error('cleanup failed')
+    })
+    await expect(closeLiveRuntime(root, 'failed-session', owner)).rejects.toThrow('cleanup failed')
+    expect(listLiveRuntimeSessions(root)).toHaveLength(1)
+  })
+  it('does not turn missing cleanup or pending feedback into idle', async () => {
+    const root = new Context()
+    const unknown = runtime(
+      async () => {},
+      () => undefined,
+    )
+    const pending = { ...runtime(async () => {}), hasRetainedHostFeedback: () => true }
+    await closeLiveRuntime(root, 'unknown-session', unknown)
+    await closeLiveRuntime(root, 'feedback-session', pending)
+    expect(
+      listLiveRuntimeSessions(root)
+        .map((row) => row.sessionId)
+        .sort(),
+    ).toEqual(['feedback-session', 'unknown-session'])
+  })
+  it('retains the original Host settlement owner after the transport is gone', async () => {
+    const root = new Context(),
+      completion = Promise.withResolvers<void>()
+    let pending = true
+    retainHostExecutionOwner(root, 'host-session', {
+      hasPendingHostCalls: () => pending,
+      waitForHostCallsSettled: () => completion.promise,
+    })
+    expect(listLiveRuntimeSessions(root)).toHaveLength(1)
+    pending = false
+    completion.resolve()
+    await completion.promise
+    await Promise.resolve()
+    expect(listLiveRuntimeSessions(root)).toEqual([])
+  })
+})
