+
+/** Actual runtime resource handles, not a session/history index. The Host root
+ * survives plugin replacement; an unconfirmed old process must remain visible. */
+export interface HostLiveRuntime extends HostExecutionOwner {
+  readonly physicalCleanupConfirmed?: boolean | undefined
+  close(): Promise<void>
+}
+interface LiveRuntimeOwner {
+  readonly sessionId: string
+  readonly runtime: HostLiveRuntime
+  closing?: Promise<void>
+  closed: boolean
+}
+const liveRuntimeKey = Symbol.for('dsh-acp-adapter.live-runtime-owners.v1')
+function liveRuntimeOwners(root: Context): Map<HostLiveRuntime, LiveRuntimeOwner> {
+  const host = globalThis as typeof globalThis & {
+    [liveRuntimeKey]?: WeakMap<object, Map<HostLiveRuntime, LiveRuntimeOwner>>
+  }
+  const roots = (host[liveRuntimeKey] ??= new WeakMap())
+  const key = hostRoot(root)
+  let owners = roots.get(key)
+  if (owners === undefined) roots.set(key, (owners = new Map()))
+  return owners
+}
+
+/** Called at the original adapter's runtime allocation boundary. */
+export function retainLiveRuntime(root: Context, sessionId: string, runtime: HostLiveRuntime): void {
+  const owners = liveRuntimeOwners(root)
+  if (!owners.has(runtime)) owners.set(runtime, { sessionId, runtime, closed: false })
+}
+
+/** Observe the original close operation without changing its result or teardown. */
+export function closeLiveRuntime(root: Context, sessionId: string, runtime: HostLiveRuntime): Promise<void> {
+  retainLiveRuntime(root, sessionId, runtime)
+  const owner = liveRuntimeOwners(root).get(runtime)!
+  if (owner.closing !== undefined) return owner.closing
+  const completion = Promise.withResolvers<void>()
+  owner.closing = completion.promise
+  try {
+    void runtime.close().then(() => {
+      owner.closed = true
+      completion.resolve()
+    }, completion.reject)
+  } catch (error) {
+    completion.reject(error)
+  }
+  return completion.promise
+}
+
+/** Read only actual owned resources. Neither headers, sidecars, profile names
+ * nor an absent/failed close observer can prove that a process has drained. */
+export function listLiveRuntimeSessions(
+  root: Context,
+): readonly { readonly sessionId: string; readonly continuity: AcpSessionContinuityState }[] {
+  const owners = liveRuntimeOwners(root)
+  const sessions = new Map<string, AcpSessionContinuityState>()
+  for (const [runtime, owner] of owners) {
+    if (owner.closed && runtime.physicalCleanupConfirmed === true && ownerIsQuiescent(runtime)) {
+      owners.delete(runtime)
+      continue
+    }
+    sessions.set(owner.sessionId, {
+      status: 'blocked',
+      cause: owner.closing === undefined ? 'runtime-owned' : 'runtime-cleanup-unconfirmed',
+      detail: null,
+    })
+  }
+  // Original retained Host calls/feedback can outlive the transport too.
+  for (const [sessionId, retained] of registry().get(hostRoot(root)) ?? []) {
+    if (retained.size > 0)
+      sessions.set(sessionId, { status: 'blocked', cause: 'host-settlement-pending', detail: null })
+  }
+  return [...sessions].map(([sessionId, continuity]) => ({ sessionId, continuity }))
+}
