diff --git a/src/host/composition/index.ts b/src/host/composition/index.ts
index bbe5397..9ba7163 100644
--- a/src/host/composition/index.ts
+++ b/src/host/composition/index.ts
@@ -33,7 +33,21 @@ export function apply(ctx: Context, config: Config): void {
   ctx.inject(['settings'], (child) => {
     child.effect(() => child.settings.configure({ auto: false }, ctx.fiber))
   })
-  installInstalledProfileRegistry(ctx, config, { installRemote: true })
+  installInstalledProfileRegistry(ctx, config, {
+    installRemote: true,
+    nativeToolHandoffGuard: (id, profile) => {
+      // Optional local Host policy, never a renderer/config boolean or profile
+      // name heuristic. A producer's captured guard survives only its generation.
+      const policy: unknown = ctx.get('acpNativeToolHandoffPolicy')
+      if (policy === undefined) return undefined
+      if (policy === null || typeof policy !== 'object' || typeof Reflect.get(policy, 'guardForProfile') !== 'function')
+        throw new TypeError('Native tool handoff policy is unavailable')
+      const guard: unknown = Reflect.apply(Reflect.get(policy, 'guardForProfile'), policy, [id, profile])
+      if (guard !== undefined && typeof guard !== 'function')
+        throw new TypeError('Native tool handoff policy returned an invalid guard')
+      return guard as (() => boolean) | undefined
+    },
+  })
   installLegacySettingsImport(ctx)
 }
 
