+// Zhuma Host-only registration contract. This checks the actual registry and
+// adapter, with the existing in-memory settings/LLM ports; no CLI or model runs.
+describe('Host native tool handoff registration', () => {
+  function current(adapter: unknown): boolean {
+    if (adapter === null || typeof adapter !== 'object') throw new Error('Missing adapter')
+    return Reflect.apply(Reflect.get(adapter, 'nativeHandoffCurrent'), adapter, []) === true
+  }
+
+  it('keeps ordinary user settings disabled without a captured Host guard', async () => {
+    const { ctx, settings, llm } = fakeHarness()
+    installInstalledProfileRegistry(ctx, settings.config)
+    await settings.replace({ agents: { foo: { ...fooAgent, nativeToolHandoff: true } } })
+    expect(current(llm.adapters[0])).toBe(false)
+  })
+
+  it('captures one generation and refuses changed complete config or revoked capability', async () => {
+    const { ctx, settings, llm } = fakeHarness()
+    let valid = true
+    const first = () => valid
+    const factory = vi.fn(() => first)
+    installInstalledProfileRegistry(ctx, settings.config, { nativeToolHandoffGuard: factory })
+    await settings.replace({ agents: { foo: fooAgent } })
+    const adapter = llm.adapters[0]
+    expect(factory).toHaveBeenCalledExactlyOnceWith('foo', fooAgent)
+    expect(current(adapter)).toBe(true)
+    valid = false
+    expect(current(adapter)).toBe(false)
+    valid = true
+    await settings.replace({ agents: { foo: { ...fooAgent, loginHint: 'changed' } } })
+    expect(current(adapter)).toBe(false)
+    expect(factory).toHaveBeenCalledTimes(1)
+    expect(llm.adapters[0]).toBe(adapter)
+  })
+
+  it('rejects a fake boolean grant and treats a throwing captured guard as unavailable', async () => {
+    const absent = fakeHarness()
+    installInstalledProfileRegistry(absent.ctx, absent.settings.config, {
+      nativeToolHandoffGuard: (() => true) as never,
+    })
+    await absent.settings.replace({ agents: { foo: fooAgent } })
+    expect(absent.llm.adapters).toHaveLength(0)
+    expect(absent.errors.length).toBeGreaterThan(0)
+    const throwing = fakeHarness()
+    installInstalledProfileRegistry(throwing.ctx, throwing.settings.config, {
+      nativeToolHandoffGuard: () => () => {
+        throw new Error('retired')
+      },
+    })
+    await throwing.settings.replace({ agents: { foo: fooAgent } })
+    expect(current(throwing.llm.adapters[0])).toBe(false)
+  })
+})
