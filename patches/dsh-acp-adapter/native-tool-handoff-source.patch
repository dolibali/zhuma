@@ -0,0 +1,72 @@
+// Keyless ACP peer: real MCP receipt and an owned descendant for drain proof.
+import readline from 'node:readline'
+import { spawn } from 'node:child_process'
+import { writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { Client, StreamableHTTPClientTransport } from '@modelcontextprotocol/client'
+const root = process.env.ZHUMA_NATIVE_HANDOFF_PROOF_DIR
+if (!root) throw new Error('owned proof directory required')
+const child = spawn(process.execPath, ['-e', 'setInterval(()=>{},1000)'], { stdio: 'ignore' })
+const state = { pids: [process.pid, child.pid], prompts: 0, receipt: undefined }
+const persist = () => writeFileSync(join(root, 'owned-peer.json'), JSON.stringify(state))
+persist()
+const send = (value) => process.stdout.write(JSON.stringify({ jsonrpc: '2.0', ...value }) + '\n')
+const client = new Client({ name: 'native-handoff-child', version: '1' })
+let pending
+let sessionId = 'synthetic-child-provider-session'
+readline.createInterface({ input: process.stdin }).on('line', (line) => {
+  void (async () => {
+    const frame = JSON.parse(line)
+    if (frame.method === 'initialize')
+      return send({
+        id: frame.id,
+        result: {
+          protocolVersion: 1,
+          agentInfo: { name: 'synthetic-child', version: '1' },
+          agentCapabilities: { mcpCapabilities: { http: true } },
+        },
+      })
+    if (frame.method === 'session/new') {
+      const server = frame.params.mcpServers.find((server) => server.type === 'http')
+      if (!server) throw new Error('own HTTP MCP server required')
+      await client.connect(new StreamableHTTPClientTransport(new URL(server.url)))
+      return send({
+        id: frame.id,
+        result: {
+          sessionId,
+          models: { currentModelId: 'fixture', availableModels: [{ modelId: 'fixture', name: 'Fixture' }] },
+          configOptions: [
+            {
+              id: 'model',
+              name: 'Model',
+              category: 'model',
+              type: 'select',
+              currentValue: 'fixture',
+              options: [{ value: 'fixture', name: 'Fixture' }],
+            },
+          ],
+        },
+      })
+    }
+    if (frame.method === 'session/prompt') {
+      pending = frame.id
+      state.prompts++
+      persist()
+      state.receipt = await client.callTool({ name: 'native_proof', arguments: {} })
+      persist()
+      if (process.argv[2] === 'hold-after-receipt') return
+      send({ id: pending, result: { stopReason: 'end_turn' } })
+      pending = undefined
+      return
+    }
+    if (frame.method === 'session/cancel') {
+      if (pending !== undefined) send({ id: pending, result: { stopReason: 'cancelled' } })
+      pending = undefined
+      return
+    }
+    if (frame.id !== undefined) send({ id: frame.id, error: { code: -32601, message: 'synthetic unsupported method' } })
+  })().catch(() => {
+    if (pending !== undefined) send({ id: pending, error: { code: -32603, message: 'synthetic peer failure' } })
+    pending = undefined
+  })
+})
