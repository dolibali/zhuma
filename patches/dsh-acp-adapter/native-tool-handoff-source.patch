+      return { provider, id: model, name: model }
+    }
+    override stream(request: GenerateOptions): AsyncIterable<StreamChunk> {
+      nativeRequests++
+      if (nativeRequests === 1) {
+        handoff.attach(
+          (async function* (): AsyncGenerator<StreamChunk> {
+            prompts++
+            lease.beginPrompt(request.signal!)
+            try {
+              const result = await client.callTool({ name: 'native_proof', arguments: {} })
+              receipt.resolve(result)
+              yield { type: 'block-start', index: 0, blockType: 'text' }
+              yield { type: 'text-delta', index: 0, text: 'provider settled after receipt' }
+              yield { type: 'block-end', index: 0, block: { type: 'text', text: 'provider settled after receipt' } }
+              yield { type: 'finish', reason: { kind: 'stop' } }
+            } finally {
+              lease.endPrompt({ stopReason: 'end_turn' })
+              await lease.drainPrompt?.()
+              remoteDrained.resolve()
+            }
+          })(),
+        )
+      }
+      return handoff.segment()
+    }
+  }
+  ctx.llm.registerAdapter(['native-proof'], new Adapter())
+  agent = await ctx.agentLoop.create(SessionId('native-proof-' + crypto.randomUUID()), {
+    provider: 'native-proof',
+    model: 'fixture',
+  })
+  const assembly = await ctx.systemPrompt.assemble({ scope: agent })
+  lease = (await createDshToolBridge(
+    ctx,
+    agent.id,
+    { mcpCapabilities: { http: true } },
+    undefined,
+    async () => 'auto',
+    undefined,
+    assembly.tools,
+  ))!
+  const server = lease.servers[0]!
+  if (!('url' in server)) throw new Error('expected HTTP MCP')
+  client = new Client({ name: 'native-tool-handoff-test', version: '1' })
+  await client.connect(new StreamableHTTPClientTransport(new URL(server.url)))
+  const off = bindNativeToolHandoff(
+    ctx,
+    agent.id,
+    (call) => {
+      handoff.enqueueNativeTool(call)
+      if (options.revokeAfterEnqueue) current = false
+    },
+    () => current,
+  )
+  return {
+    ctx,
+    agent,
+    handoff,
+    entered,
+    release,
+    receipt,
+    remoteDrained,
+    bodies: () => bodies,
+    prompts: () => prompts,
+    nativeRequests: () => nativeRequests,
+    revoke: () => {
+      current = false
+    },
+    async close() {
+      release.resolve()
+      off()
+      await client.close()
+      await lease.close()
+      await ctx.fiber.dispose()
+    },
+    start() {
+      agent.followup(
+        createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text: 'Synthetic no-model proof' }] }),
+      )
+    },
+  }
+}
+
+describe('actual SDK AgentLoop + HTTP MCP native handoff', () => {
+  for (const conclude of [false, true])
+    it(`executes once and returns the same real result, conclude=${conclude}`, async () => {
+      const h = await harness({ conclude })
+      try {
+        h.start()
+        await h.agent.whenIdle()
+        if (conclude) await h.handoff.drain()
+        await h.remoteDrained.promise
+        const result = (await h.receipt.promise) as { content: unknown[]; isError?: boolean }
+        expect(result.isError).not.toBe(true)
+        expect(JSON.stringify(result.content)).toContain('real canonical tool receipt')
+        expect(h.bodies()).toBe(1)
+        expect(h.prompts()).toBe(1)
+        const events = h.agent.session.snapshotEvents()
+        const call = events.find((event) => event.type === 'tool/call')!
+        const toolResult = events.find((event) => event.type === 'tool/result')!
+        expect(toolResult.sourceEventSeqs).toEqual([call.seq])
+        if (conclude)
+          expect(events.filter((event) => event.seq > call.seq && event.type === 'assistant/message')).toHaveLength(0)
+        expect(h.handoff.ended).toBe(true)
+      } finally {
+        await h.close()
+      }
+    })
+  it('returns an actual tool exception without replay', async () => {
+    const h = await harness({ throws: true })
+    try {
+      h.start()
+      await h.agent.whenIdle()
+      await h.remoteDrained.promise
+      expect(((await h.receipt.promise) as { isError: boolean }).isError).toBe(true)
+      expect(h.bodies()).toBe(1)
+      expect(h.prompts()).toBe(1)
+    } finally {
+      await h.close()
+    }
+  })
+  it('cancels a held body and does not accept a late success', async () => {
+    const h = await harness({ held: true })
+    try {
+      h.start()
+      await h.entered.promise
+      h.agent.cancel({ kind: 'user' })
+      h.release.resolve()
+      await h.agent.whenIdle()
+      await h.handoff.drain()
+      await h.remoteDrained.promise
+      expect(((await h.receipt.promise) as { isError: boolean }).isError).toBe(true)
+      expect(h.bodies()).toBe(1)
+      expect(h.prompts()).toBe(1)
+    } finally {
+      await h.close()
+    }
+  })
+  it('rejects a duplicate handoff id before a second native execution', async () => {
+    const handoff = new StreamHandoff()
+    const call = {
+      callId: 'same-id' as never,
+      name: 'native_proof',
+      arguments: {},
+      signal: new AbortController().signal,
+    }
+    handoff.enqueueNativeTool(call)
+    expect(() => handoff.enqueueNativeTool(call)).toThrow('ACP_NATIVE_TOOL_HANDOFF_REJECTED')
+  })
+  it('does not fall back to direct execution after generation revocation', async () => {
+    const h = await harness()
+    try {
+      h.revoke()
+      h.start()
+      await h.agent.whenIdle()
+      await h.remoteDrained.promise
+      expect(((await h.receipt.promise) as { isError: boolean }).isError).toBe(true)
+      expect(h.bodies()).toBe(0)
+    } finally {
+      await h.close()
+    }
+  })
+  it('rechecks generation between enqueue and actual native execution', async () => {
+    const h = await harness({ revokeAfterEnqueue: true })
+    try {
+      h.start()
+      await h.agent.whenIdle()
+      await h.remoteDrained.promise
+      expect(((await h.receipt.promise) as { isError: boolean }).isError).toBe(true)
+      expect(h.bodies()).toBe(0)
+    } finally {
+      await h.close()
+    }
+  })
+  it('does not accept late success after revocation or pretend the body never ran', async () => {
+    const h = await harness({ held: true })
+    try {
+      h.start()
+      await h.entered.promise
+      h.revoke()
+      h.release.resolve()
+      await h.agent.whenIdle()
+      await h.remoteDrained.promise
+      expect(((await h.receipt.promise) as { isError: boolean }).isError).toBe(true)
+      expect(h.bodies()).toBe(1)
+      expect(h.agent.session.snapshotEvents().find((event) => event.type === 'tool/result')?.data).toMatchObject({
+        message: { isError: false },
+      })
+    } finally {
+      await h.close()
+    }
+  })
+})
