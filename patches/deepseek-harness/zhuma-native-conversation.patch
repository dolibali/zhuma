+/** Original journal passive follow with controlled prepared observations. */
+import { expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SessionStore from '@deepseek-ai/dsh-session'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import { SessionHistoryController } from '../src/history.ts'
+import { installSessionReadTestServices } from './test-remote.ts'
+
+it.each([false, true])('prepared follow activate=%s keeps snapshot and controls promotion', async (activate) => {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  installSessionReadTestServices(ctx)
+  const session = ctx.sessions.create('passive-native-proof' as SessionId, { meta: { cwd: '/fixture' } })
+  const observe = ctx.sessionQuery.observeSession.bind(ctx.sessionQuery)
+  const retain = vi.fn()
+  vi.spyOn(ctx.sessionQuery, 'observeSession').mockImplementation(async (...args) => {
+    const original = await observe(...args)
+    return { ...original, source: 'prepared' as const,
+      retain() { retain(); return original.retain() },
+      [Symbol.dispose]() { original[Symbol.dispose]() },
+    }
+  })
+  const promote = vi.fn((observation) => observation[Symbol.dispose]())
+  const history = new SessionHistoryController(ctx, promote)
+  const abort = new AbortController()
+  const stream = history.follow({ address: { kind: 'session', sessionId: session.id } }, abort.signal, activate)[Symbol.asyncIterator]()
+  try {
+    expect(await stream.next()).toMatchObject({ done: false, value: { type: 'snapshot', header: { id: session.id }, records: expect.any(Array) } })
+    const pending = stream.next()
+    await new Promise(resolve => setTimeout(resolve, 0))
+    expect(promote).toHaveBeenCalledTimes(activate ? 1 : 0)
+    expect(retain).toHaveBeenCalledTimes(activate ? 1 : 0)
+    abort.abort()
+    await pending
+  } finally {
+    abort.abort()
+    await stream.return?.()
+    await ctx.fiber.dispose()
+  }
+})
