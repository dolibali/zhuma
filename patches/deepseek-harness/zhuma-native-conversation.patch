+/** Original SessionStore disposal and SessionController catalog; synthetic metadata, no model or log writes. */
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import { SessionPersistenceRevision } from '@deepseek-ai/dsh-session-persistence'
+import type { SessionPersistenceSnapshot } from '@deepseek-ai/dsh-session-persistence'
+import { expect, it, vi } from 'vitest'
+import type { SessionSummary } from '../src/types.ts'
+import { createSessionTestController, testSessionPersistence } from './test-remote.ts'
+
+async function bench(stat: () => Promise<SessionPersistenceSnapshot | undefined>) {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(AgentRegistry)
+  const inspect = vi.fn(() => { throw new Error('catalog must not read transcript') })
+  ctx.provide('sessionPersistence', testSessionPersistence(ctx, { stat, inspect }) as never)
+  createSessionTestController(ctx, { cwd: '/fixture', defaultModelSelection: () => ({ provider: 'fixture', model: 'fixture' }) })
+  // Capture only the public wire data. The real Client projection has its own
+  // Client-side spec; importing it here merges incompatible Cordis programs.
+  const catalog = new Map<SessionId, SessionSummary>()
+  ctx.on('api-session/added', summary => catalog.set(summary.sessionId, structuredClone(summary)))
+  ctx.on('api-session/removed', id => catalog.delete(id))
+  const added = vi.fn(), removed = vi.fn(), failed = vi.fn()
+  ctx.on('api-session/added', added)
+  ctx.on('api-session/removed', removed)
+  ctx.on('api-session/error', failed)
+  function enter(id: string, createdAt = 1) {
+    const session = ctx.sessions.prepare(SessionId(id), { meta: { cwd: '/fixture', createdAt } })
+    const detach = ctx.sessions.enter(session)
+    ctx.sessions.announce(session)
+    return { session, detach }
+  }
+  return { ctx, catalog, added, removed, failed, inspect, enter }
+}
+
+it.each([true, false])('native owner disposal retains a stored catalog row when persisted=%s', async (persisted) => {
+  let stored: SessionPersistenceSnapshot | undefined
+  const stat = vi.fn(async () => stored)
+  const b = await bench(stat)
+  try {
+    const a = b.enter('native-catalog-A'), other = b.enter('native-catalog-B')
+    stored = persisted ? { header: structuredClone(a.session.header), revision: SessionPersistenceRevision('metadata') } : undefined
+    await vi.waitFor(() => expect(b.catalog.size).toBe(2))
+    b.added.mockClear()
+    a.detach()
+    await vi.waitFor(() => expect(stat).toHaveBeenCalledOnce())
+    await vi.waitFor(() => expect(b.added.mock.calls.length + b.removed.mock.calls.length).toBe(1))
+    if (persisted) {
+      expect(b.added).toHaveBeenCalledWith(expect.objectContaining({ sessionId: a.session.id, running: false, agentAvailable: false }))
+      expect(b.removed).not.toHaveBeenCalled()
+    } else expect(b.removed).toHaveBeenCalledWith(a.session.id)
+    await vi.waitFor(() => expect(b.catalog.size).toBe(persisted ? 2 : 1))
+    expect(b.catalog.get(other.session.id)).toBeDefined()
+    expect(b.ctx.sessions.get(other.session.id)).toBe(other.session)
+    expect(b.inspect).not.toHaveBeenCalled()
+  } finally { await b.ctx.fiber.dispose() }
+})
+
+it('a late old disposal cannot remove a newly attached generation of the same SID', async () => {
+  const pending = Promise.withResolvers<SessionPersistenceSnapshot | undefined>()
+  const b = await bench(() => pending.promise)
+  try {
+    const old = b.enter('native-catalog-same')
+    old.detach()
+    const current = b.enter('native-catalog-same', 2)
+    b.added.mockClear()
+    pending.resolve(undefined)
+    await new Promise(resolve => setTimeout(resolve, 0))
+    expect(b.removed).not.toHaveBeenCalled()
+    expect(b.ctx.sessions.get(current.session.id)).toBe(current.session)
+    expect(b.added).not.toHaveBeenCalled()
+    await vi.waitFor(() => expect(b.catalog.get(current.session.id)?.updatedAt).toBe(2))
+  } finally { pending.resolve(undefined); await b.ctx.fiber.dispose() }
+})
+
+it('unknown metadata availability reports failure without certifying catalog deletion', async () => {
+  const stat = vi.fn(async () => { throw new Error('synthetic unavailable') })
+  const b = await bench(stat)
+  try {
+    const a = b.enter('native-catalog-unknown')
+    a.detach()
+    await vi.waitFor(() => expect(b.failed).toHaveBeenCalledOnce())
+    expect(b.removed).not.toHaveBeenCalled()
+    await vi.waitFor(() => expect(b.catalog.get(a.session.id)).toBeDefined())
+    expect(b.inspect).not.toHaveBeenCalled()
+  } finally { await b.ctx.fiber.dispose() }
+})
