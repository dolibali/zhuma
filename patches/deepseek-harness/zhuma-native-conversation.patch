+  const seen: unknown[] = []
+  const dispose = ctx.typertGateway.registerSessionAdmission(async (method, args) => {
+    seen.push({ method, args }); return args.agentId === 'ordinary'
+  })
+  const call = (agentId: string) => ctx.typertGateway.invoke({ peer: ownerPeer(ctx), namespace: 'commands', method: 'execute', args: { agentId } })
+  try {
+    await expect(call('task')).rejects.toMatchObject({ code: 'gateway/invocation-unavailable' })
