{
  "name": "read_accepted_file",
  "description": "List files of an explicitly frozen accepted input, then read a selected UTF-8 byte range. Metadata is not proof of reading. Never fetches links, renders PDF/images, or opens a caller path.",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": ["inputRef", "part"],
    "properties": {
      "inputRef": {
        "type": "string"
      },
      "part": {
        "type": "string",
        "enum": ["files", "file"]
      },
      "fileId": {
        "type": "string",
        "description": "Required only for part=file; use the catalog fileId."
      },
      "offset": {
        "type": "integer",
        "default": 0,
        "description": "Only for part=file. Nonnegative safe byte offset; defaults to 0."
      },
      "length": {
        "type": "integer",
        "default": 4096,
        "description": "Only for part=file. Byte length from 1 to 8192; defaults to 4096."
      }
    }
  },
