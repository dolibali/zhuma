    "type": "object",
    "additionalProperties": false,
    "required": ["links"],
    "properties": {
      "text": {
        "type": "string",
        "description": "Optional result text, at most 100000 characters."
      },
      "links": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "At most 20 absolute HTTP(S) URLs without userinfo. Use [] when delivering text only."
      }
    }
  },
