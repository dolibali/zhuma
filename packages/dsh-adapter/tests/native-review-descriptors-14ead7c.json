    "name": "read_review_target",
    "sourceVersion": "zhuma-native-review-read@1",
    "description": "Read actual fixed-target body bytes using one resource reference from the Host review catalog. The Host binds this review Run, round, artifact and configured reviewer; none is selected by these arguments. Request a nonnegative byte offset and 1–8192 bytes. At most 16 attempts and 65536 returned body bytes are allowed per Run. Only a successful UTF-8 body page can support a completion anchor/read reference; catalog, metadata, EOF, unsupported or failed reads are not body-read evidence. Partial pages prove only their actual ranges. Report unsupported required material rather than claim it was reviewed. No paths, URLs, identities, target IDs or permission claims.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceRef", "offset", "length"],
      "properties": {
        "resourceRef": {
          "type": "string",
          "description": "An exact entry from this Host-bound review resource catalog."
        },
        "offset": {
          "type": "integer",
          "description": "Nonnegative byte offset, never a character index."
        },
        "length": {
          "type": "integer",
          "description": "1–8192 requested bytes. Only actual returned bytes are evidenced."
        }
      }
    },
