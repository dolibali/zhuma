  "completeReview": {
    "name": "complete_review",
    "sourceVersion": "zhuma-native-review-intent@1",
    "description": "Declare one independent review of the Host-bound fixed target. Submit approve, request-changes or comment with a nonempty rationale (at most 100000 characters), at most 50 byte-range anchors and 1–16 unique read references returned by successful read_review_target calls in this review Run. The entire argument JSON is limited to 120000 UTF-8 bytes, including syntax, escaping and whitespace. Its JSON arguments field plus a 16384-byte reserved envelope must fit the unchanged 262144-byte public frame. The Host rejects over-budget declarations before intent/ACK without truncation. Anchors must be within those actual returned ranges. Do not claim the whole target was read from a partial manifest. Unsupported required material prevents a decision; comment records an opinion and leaves the review obligation pending. Supply no actor, reviewer, round, target, permission or read-proof claim. This ends the native turn, not the review round: the Host separately authenticates reads, completion cut and original writer retirement before the original Service may record an idempotent ballot. Do not issue further work or tools after declaration.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "rationale", "anchors", "evidenceRefs"],
      "properties": {
        "conclusion": {
          "type": "string",
          "enum": ["approve", "request-changes", "comment"]
        },
        "rationale": {
          "type": "string",
          "description": "Nonempty review reasoning, at most 100000 characters and within the total 120000-byte UTF-8 JSON argument budget."
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "resourceRef": {
                "type": "string"
              },
              "offset": {
                "type": "integer"
              },
              "length": {
                "type": "integer"
              }
            },
            "required": ["resourceRef", "offset", "length"],
            "additionalProperties": false
          },
          "description": "At most 50 positive byte ranges within actual successful read pages, never character offsets."
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "1–16 unique Host read references from this same independent review Run."
        }
      }
    },
